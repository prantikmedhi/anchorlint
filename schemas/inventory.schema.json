{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prantikmedhi.github.io/anchorlint/inventory.schema.json",
  "title": "AnchorLint inventory v1",
  "type": "object",
  "required": [
    "schema_version",
    "base_url",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "assets": {
      "description": "Optional non-HTML file URL identities: existence-only evidence, never content or fragment evidence. Runtime also enforces same origin, no credentials/query/fragment/dot segments, no directory or HTML paths, normalized uniqueness, no overlap with pages, and aggregate evidence bounds.",
      "type": "array",
      "default": [],
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "minLength": 1,
        "maxLength": 2000000,
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^?#\\s\\\\]+$"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "url",
          "title",
          "text",
          "links"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "maxLength": 2000000
          },
          "text": {
            "type": "string",
            "maxLength": 2000000
          },
          "headings": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "string"
            }
          },
          "ids": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "string"
            }
          },
          "noindex": {
            "type": "boolean"
          },
          "links": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "object",
              "required": [
                "href",
                "anchor",
                "context"
              ],
              "properties": {
                "href": {
                  "type": "string",
                  "maxLength": 2000000
                },
                "anchor": {
                  "type": "string",
                  "maxLength": 2000000
                },
                "context": {
                  "type": "string",
                  "maxLength": 2000000
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
